# Copy to .env and fill in. Every key the app actually reads is listed here;
# anything with a working default lives in app/core/config.py instead of here.
# .env is gitignored — never commit real credentials.

# --- Supabase (auth + case/user data) -----------------------------------------
# JWTs are verified against the project's JWKS endpoint (app/core/security.py),
# so no JWT secret is needed.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Voyage AI (query embeddings) ---------------------------------------------
# VOYAGE_MODEL must match what the pipeline indexed with (voyage-law-2).
VOYAGE_API_KEY=

# --- OpenSearch ---------------------------------------------------------------
# Local dev: leave all of this unset. The defaults in config.py point at the
# no-auth cluster from docker-compose.yml (localhost:9200).
# Production (deploy/gcp): all six are required.
#OPENSEARCH_HOST=
#OPENSEARCH_PORT=9200
#OPENSEARCH_USE_SSL=true
#OPENSEARCH_VERIFY_CERTS=false     # demo self-signed certs on the cluster
#OPENSEARCH_USER=admin
#OPENSEARCH_PASSWORD=

# --- Billing (Razorpay) -------------------------------------------------------
# Only needed to exercise the paid tier; the app runs without them (everyone
# stays on the free tier). See BILLING_SETUP.md.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=

# --- Misc ---------------------------------------------------------------------
#DEBUG=false
#CORS_ORIGINS=["http://localhost:3000"]
