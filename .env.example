# Copy this file to .env and fill in real values. Never commit .env itself.

# Application
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL via Supabase)
DATABASE_URL=postgresql://user:password@host:port/postgres

VOYAGE_API_KEY=your_voyage_api_key_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Meilisearch Configuration (replaced OpenSearch)
MEILISEARCH_HOST=localhost
MEILISEARCH_PORT=7700
MEILISEARCH_MASTER_KEY=your-master-key-change-in-production
MEILISEARCH_INDEX=legal_cases

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=dev-secret-key-change-in-production
API_KEY=dev-api-key-change-in-production

# CORS Origins (JSON format with quotes)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# GCS PDF storage (HMAC interoperability creds, not a service-account key —
# see HANDOVER.md for why: an org policy on the GCP project blocks both
# service-account JSON keys and service-account HMAC keys; a user-account
# HMAC key from Cloud Storage -> Settings -> Interoperability is not covered)
GCS_BUCKET=law-helper-case-pdfs
GCS_HMAC_ACCESS_KEY=your_gcs_hmac_access_key_here
GCS_HMAC_SECRET_KEY=your_gcs_hmac_secret_key_here
